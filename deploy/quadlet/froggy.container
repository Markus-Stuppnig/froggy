[Unit]
Description=Froggy app (Deno + Hono + htmx)
After=froggy-build.service
Requires=froggy-build.service

[Container]
ContainerName=froggy
Image=froggy.build
Network=zukunftssicher.network
Environment=PORT=8000
EnvironmentFile=%h/zukunftssicher/froggy/deploy/secrets.env
Volume=froggy-data.volume:/data
HealthCmd=deno eval "const r = await fetch('http://localhost:8000/health'); Deno.exit(r.ok ? 0 : 1)"

[Service]
Restart=always

[Install]
WantedBy=default.target
