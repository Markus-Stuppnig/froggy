# Kopieren nach deploy/secrets.env (wird nicht eingecheckt).

# Caddy: Basic Auth für die Web-App.
# Hash erzeugen: podman run --rm -it docker.io/library/caddy:2.11.9-alpine caddy hash-password
BASIC_AUTH_USER=markus
BASIC_AUTH_HASH=

# froggy: Bearer-Token für /mcp. Leer/entfernt = MCP aus.
# Erzeugen: openssl rand -hex 32
MCP_TOKEN=
