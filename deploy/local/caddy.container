[Unit]
Description=Caddy reverse proxy
After=froggy.service
Requires=froggy.service

[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2.11.9-alpine
Network=froggy.network
PublishPort=8080:80
PublishPort=8443:443
Volume=%h/zukunftssicher/froggy/deploy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=caddy-data:/data
Volume=caddy-config:/config
Environment=SITE_ADDRESS=:80
EnvironmentFile=%h/zukunftssicher/froggy/deploy/secrets.env

[Service]
Restart=always

[Install]
WantedBy=default.target
